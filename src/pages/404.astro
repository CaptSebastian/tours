---
import Base from '../layouts/Base.astro';
import { defaultLocale } from '../i18n/locales';
import { t } from '../i18n/ui';
const lang = defaultLocale;
---
<Base title={t(lang, '404.title')} lang={lang}>
  <section class="hero">
    <div class="wrap">
      <h1>{t(lang, '404.title')}</h1>
      <p class="lead">{t(lang, '404.text')}</p>
      <a class="button" href="/">{t(lang, '404.button')}</a>
    </div>
  </section>
</Base>
