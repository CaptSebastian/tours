---
// /go/<tour> en /go/tips — hier landen de korte links en QR-codes.
import LanguagePicker from '../../components/LanguagePicker.astro';
import { getTours } from '../../lib/content';
import { defaultLocale } from '../../i18n/locales';

export function getStaticPaths() {
  const tours = getTours(defaultLocale).map((t) => ({
    params: { target: t.slug },
    props: { path: `${t.slug}/`, heading: t.menuTitle },
  }));
  return [...tours, { params: { target: 'tips' }, props: { path: 'tips/', heading: "Captain's tips" } }];
}

const { path, heading } = Astro.props;
---
<LanguagePicker target={path} heading={heading} />
