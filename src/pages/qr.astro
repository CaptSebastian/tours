---
// Printbare QR-codes voor aan boord: captainsebastian.nl/qr/
// Niet gelinkt in het menu. Print deze pagina (Cmd/Ctrl+P) of sla hem op als PDF.
import QRCode from 'qrcode';
import Base from '../layouts/Base.astro';
import { shortlinks } from '../shortlinks.mjs';
import { getTours } from '../lib/content';
import { defaultLocale } from '../i18n/locales';

const site = (Astro.site ?? new URL('https://captainsebastian.nl')).origin;
const names = Object.fromEntries(getTours(defaultLocale).map((t) => [t.slug, t.menuTitle]));
names['tips'] = "Captain's Amsterdam tips";

const codes = await Promise.all(
  Object.entries(shortlinks).map(async ([code, target]) => {
    const url = `${site}/${code}`;
    const svg = await QRCode.toString(url, { type: 'svg', margin: 1, errorCorrectionLevel: 'M', color: { dark: '#0f2a3d', light: '#ffffff' } });
    return { code, url, label: names[target] ?? target, svg };
  })
);
---
<Base title="QR codes">
  <section class="wrap qr-page">
    <h1>QR codes</h1>
    <p class="muted no-print">Print deze pagina of bewaar hem als PDF. Elke code opent eerst de taalkeuze en daarna de juiste pagina.</p>
    <div class="qr-grid">
      {codes.map((c) => (
        <figure class="qr-card">
          <div class="qr-svg" set:html={c.svg} />
          <figcaption>
            <strong>{c.label}</strong>
            <span>{c.url.replace(/^https?:\/\//, '')}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
</Base>

<style>
  .qr-page { padding: 2rem 0 4rem; }
  .qr-grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .qr-card {
    margin: 0; padding: 1.25rem; background: #fff; color: #0f2a3d;
    border: 1px solid var(--line); border-radius: var(--radius); text-align: center;
    break-inside: avoid;
  }
  .qr-svg :global(svg) { width: 100%; height: auto; display: block; }
  figcaption { display: grid; gap: .2rem; margin-top: .75rem; }
  figcaption span { font-size: .9rem; color: #5d6a73; }
  @media print { .no-print { display: none; } .qr-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
