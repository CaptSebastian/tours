---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';
import { getLocale, defaultLocale } from '../i18n/locales';
import { t } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  /** Pad zonder taal, bv. 'central-station-tour-1/' — voor de taalwisselaar */
  path?: string;
  /** Geen header/footer (taalkeuzescherm) */
  bare?: boolean;
}
const { title, description, lang = defaultLocale, path = '', bare = false } = Astro.props;
const locale = getLocale(lang);
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${t(lang, 'site.tagline')}`;
---
<!doctype html>
<html lang={locale.code} dir={locale.dir ?? 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <!-- Net als op de huidige site: niet indexeren door zoekmachines. Verwijder deze regel als dat wel mag. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0f2a3d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    {!bare && <Header lang={lang} path={path} />}
    <main>
      <slot />
    </main>
    {!bare && <Footer lang={lang} />}

    <script>
      // Offline lezen: registreer de service worker (zie public/sw.js).
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }
    </script>
  </body>
</html>
