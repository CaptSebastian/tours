---
import { t } from '../i18n/ui';
import { getTips } from '../lib/content';
interface Props { lang: string }
const { lang } = Astro.props;
// Het aantal tips telt automatisch mee, zodat de knop altijd klopt.
const n = getTips(lang).items.length;
---
<aside class="tips-promo">
  <div>
    <h2>{t(lang, 'promo.title')}</h2>
    <p>{t(lang, 'promo.text')}</p>
  </div>
  <a class="button" href={`/${lang}/tips/`}>{t(lang, 'promo.button', { n })}</a>
</aside>
