---
import { site } from '../site';
import { t } from '../i18n/ui';

interface Props { lang: string }
const { lang } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-inner">
    <div>
      <p class="footer-brand">{site.name}</p>
      <p class="muted">{t(lang, 'site.tagline')}</p>
    </div>
    <div>
      <h2 class="footer-heading">{t(lang, 'footer.bookings')}</h2>
      <p class="muted">{t(lang, 'footer.bookText')}</p>
      <div class="book-buttons">
        {site.bookings.map((b) => (
          <a class="book-button" href={b.url} target="_blank" rel="noopener">{t(lang, 'footer.bookWith', { name: b.label })} →</a>
        ))}
      </div>
    </div>
    <div>
      <h2 class="footer-heading">{t(lang, 'footer.contact')}</h2>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
  </div>
  <p class="wrap copyright">© {year} Captain Sebastian Amsterdam · <a href={`/${lang}/credits/`}>{t(lang, 'footer.credits')}</a></p>
</footer>
