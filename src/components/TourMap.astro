---
// Eigen routekaart (Leaflet + CARTO-tegels). Nummers linken naar #stop-n op de pagina.
import { t } from '../i18n/ui';
interface Props { slug: string; lang: string; label: string; stops: { number: number; title: string }[] }
const { slug, lang, label, stops } = Astro.props;
const all = import.meta.glob('../data/maps/*.json', { eager: true }) as Record<string, any>;
const data = all[`../data/maps/${slug}.json`]?.default;
const points = data
  ? stops.filter((s) => data.points[s.number]).map((s) => ({ n: s.number, t: s.title, p: data.points[s.number] }))
  : [];
---
<div class="map tour-map" aria-label={label} data-locate={t(lang, 'map.locate')} data-locate-error={t(lang, 'map.locateError')} data-locate-denied={t(lang, 'map.locateDenied')} data-route={JSON.stringify(data?.route ?? [])} data-points={JSON.stringify(points)}>
    <div class="tour-map-canvas"></div>
  </div>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
  <script is:inline>
    (() => {
      const el = document.querySelector('.tour-map');
      if (!el || !window.L) return;
      const route = JSON.parse(el.dataset.route);
      const points = JSON.parse(el.dataset.points);
      const map = L.map(el.querySelector('.tour-map-canvas'), { scrollWheelZoom: false, zoomControl: true, attributionControl: true });
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map);
      L.polyline(route, { color: '#ffffff', weight: 8, opacity: .9, lineJoin: 'round', lineCap: 'round' }).addTo(map);
      const line = L.polyline(route, { color: '#17405c', weight: 4, opacity: .9, lineJoin: 'round', lineCap: 'round' }).addTo(map);
      for (const s of points) {
        const icon = L.divIcon({ className: 'map-num', html: `<span>${s.n}</span>`, iconSize: [30, 30], iconAnchor: [15, 15] });
        L.marker(s.p, { icon, title: `${s.n}. ${s.t}`, keyboard: true }).addTo(map)
          .on('click', () => { location.hash = `stop-${s.n}`; });
      }
      map.fitBounds(line.getBounds(), { padding: [28, 28] });

      // "U bent hier": pas na een tik op de knop, zodat de telefoon niet ongevraagd om de locatie vraagt.
      if ('geolocation' in navigator) {
        const Locate = L.Control.extend({
          options: { position: 'topright' },
          onAdd() {
            const b = L.DomUtil.create('button', 'map-locate');
            b.type = 'button';
            b.textContent = el.dataset.locate;
            L.DomEvent.disableClickPropagation(b);
            b.addEventListener('click', start);
            this.btn = b;
            return b;
          },
        });
        const ctl = new Locate().addTo(map);
        let dot, ring, watching = false, centered = false;
        function show(pos) {
          const ll = [pos.coords.latitude, pos.coords.longitude];
          ctl.btn.classList.remove('is-busy'); ctl.btn.classList.add('is-on');
          ctl.btn.textContent = el.dataset.locate;
          if (!dot) {
            ring = L.circle(ll, { radius: pos.coords.accuracy, color: '#2f80ed', weight: 1, opacity: .4, fillOpacity: .08, interactive: false }).addTo(map);
            dot = L.marker(ll, { icon: L.divIcon({ className: 'map-me', html: '<span></span>', iconSize: [20, 20], iconAnchor: [10, 10] }), interactive: false, zIndexOffset: 1000 }).addTo(map);
          } else { dot.setLatLng(ll); ring.setLatLng(ll).setRadius(pos.coords.accuracy); }
          if (!centered) { centered = true; map.setView(ll, Math.max(map.getZoom(), 16)); }
        }
        function fail(err) {
          watching = false; ctl.btn.classList.remove('is-busy', 'is-on');
          console.warn('[kaart] locatie mislukt', err && err.code, err && err.message, 'secure:', window.isSecureContext);
          const msg = !window.isSecureContext || (err && err.code === 1) ? el.dataset.locateDenied : el.dataset.locateError;
          ctl.btn.textContent = msg;
          setTimeout(() => { if (!watching) ctl.btn.textContent = el.dataset.locate; }, 5000);
        }
        function watch(precise) {
          return navigator.geolocation.watchPosition(show, (err) => {
            // Binnen of op wifi lukt nauwkeurige gps soms niet: dan nog één keer grof proberen.
            if (precise && err.code !== 1) { navigator.geolocation.clearWatch(id); id = watch(false); }
            else fail(err);
          }, precise
            ? { enableHighAccuracy: true, maximumAge: 5000, timeout: 12000 }
            : { enableHighAccuracy: false, maximumAge: 60000, timeout: 20000 });
        }
        let id;
        function start() {
          if (watching) { if (dot) map.setView(dot.getLatLng(), Math.max(map.getZoom(), 16)); return; }
          if (!window.isSecureContext) return fail({ code: 1, message: 'insecure context' });
          watching = true; ctl.btn.classList.add('is-busy');
          id = watch(true);
        }
      }
    })();
  </script>
